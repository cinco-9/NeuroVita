# Exemplo de secrets para Streamlit Cloud
# Copie este arquivo para secrets.toml e preencha os valores

# Supabase
SUPABASE_URL = "sua_url_aqui"
SUPABASE_KEY = "sua_key_aqui"

# Instruções para configurar no Streamlit Cloud:
# 1. Acesse seu app em share.streamlit.io
# 2. Clique em "Settings" > "Secrets"
# 3. Cole o conteúdo acima com os valores reais
